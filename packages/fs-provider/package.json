{
  "name": "@citycom/fs-provider",
  "version": "1.0.0",
  "description": "Blob store DB-based file system provider library",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {
    "uuid": "^9.0.0",
    "mime-types": "^2.1.35"
  },
  "devDependencies": {
    "@types/jest": "^29.5.11",
    "@types/mime-types": "^2.1.4",
    "@types/uuid": "^9.0.7",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "typescript": "^5.3.0"
  },
  "peerDependencies": {
    "@prisma/client": "^5.7.0"
  },
  "peerDependenciesMeta": {
    "@prisma/client": {
      "optional": true
